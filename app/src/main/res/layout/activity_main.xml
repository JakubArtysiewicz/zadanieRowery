<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wypożycz rower"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />

    <EditText
        android:id="@+id/Imie"
        android:layout_width="388dp"
        android:layout_height="71dp"
        android:layout_marginStart="16dp"
        android:ems="10"
        android:hint="Twoje Imię"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="194dp"
        android:layout_height="156dp"
        android:layout_marginStart="108dp"
        android:layout_marginTop="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Imie">

        <RadioButton
            android:id="@+id/Miejski"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Miejski (15 zł)" />

        <RadioButton
            android:id="@+id/Gorski"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Górski (25 zł)" />

        <RadioButton
            android:id="@+id/Elektryczny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elektryczny (40 zł)" />
    </RadioGroup>

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="144dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#0866B1"
        android:text="WYPOŻYCZ"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup" />

</androidx.constraintlayout.widget.ConstraintLayout>